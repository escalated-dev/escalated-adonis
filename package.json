{
  "name": "@escalated-dev/escalated-adonis",
  "description": "An embeddable support ticket system for AdonisJS v7 applications",
  "version": "0.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./services/*": "./build/src/services/*.js",
    "./models/*": "./build/src/models/*.js",
    "./middleware/*": "./build/src/middleware/*.js",
    "./controllers/*": "./build/src/controllers/*.js",
    "./support/*": "./build/src/support/*.js",
    "./events": "./build/src/events/index.js",
    "./types": "./build/src/types.js",
    "./providers/*": "./build/providers/*.js",
    "./commands/*": "./build/src/commands/*.js",
    "./contracts/*": "./build/src/contracts/*.js",
    "./configure": "./build/configure.js"
  },
  "files": [
    "build",
    "configure.ts",
    "stubs",
    "database",
    "start"
  ],
  "scripts": {
    "build": "tsc && npm run copy:stubs",
    "build:emit": "tsc --noEmitOnError false || true && npm run copy:stubs",
    "copy:stubs": "node ./scripts/copy-build-assets.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "test": "node --test tests/*.test.js tests/unit/*.spec.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@escalated-dev/locale": "github:escalated-dev/escalated-locale#v0.1.8",
    "@escalated-dev/plugin-sdk": "https://codeload.github.com/escalated-dev/escalated-plugin-sdk/tar.gz/refs/tags/v0.1.2",
    "@xmldom/xmldom": "^0.9.10",
    "luxon": "^3.7.2"
  },
  "prettier": "@adonisjs/prettier-config",
  "keywords": [
    "adonisjs",
    "support",
    "tickets",
    "helpdesk",
    "customer-support",
    "inertia",
    "plugins"
  ],
  "peerDependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/cache": "^2.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^4.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/transmit": "^3.0.0",
    "adm-zip": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/transmit": {
      "optional": true
    },
    "adm-zip": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.2.1",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/transmit": "^3.0.1",
    "@japa/runner": "^5.3.0",
    "@types/adm-zip": "^0.5.5",
    "@types/luxon": "^3.7.1",
    "adm-zip": "^0.5.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/escalated-dev/escalated-adonis"
  }
}
